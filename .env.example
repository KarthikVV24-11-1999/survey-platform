# Copy to .env.local for local development. Never commit real values.
# Generate secrets with:  openssl rand -base64 48

# --- Core (required) ---------------------------------------------------------
# Postgres connection string. On Neon use the *pooled* URL here.
DATABASE_URL=postgres://localhost:5432/survey_dev
# Direct (non-pooled) URL used only for migrations. Optional locally.
DATABASE_URL_UNPOOLED=
# Separate, disposable database for integration tests (wiped on every test run).
TEST_DATABASE_URL=postgres://localhost:5432/survey_test
# Public origin of the app, no trailing slash (https:// in production).
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Separate key for hashing anonymous voter tokens and IP addresses.
HASH_SECRET=

# --- Sign-in (configure at least one in production) --------------------------
# GitHub: https://github.com/settings/developers  -> callback {APP_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google: https://console.cloud.google.com/apis/credentials -> callback {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email magic links via Resend (needs a verified sending domain). Locally,
# links are printed to the terminal when this is empty.
RESEND_API_KEY=
EMAIL_FROM="Survey Platform <login@your-domain.com>"

# --- Bot protection (required in production) ----------------------------------
# Cloudflare Turnstile: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Auto-moderation ------------------------------------------------------------
# OpenAI moderation endpoint (free). Without it, new content waits for a moderator.
OPENAI_API_KEY=

# --- Image storage ----------------------------------------------------------------
# local (dev only, writes to ./.data) or s3 (Cloudflare R2 / AWS S3 / MinIO)
STORAGE_DRIVER=local
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Operations --------------------------------------------------------------------
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" (required in production).
CRON_SECRET=
# Header carrying the real client IP, set by your host's edge (Vercel: x-real-ip).
TRUSTED_IP_HEADER=x-real-ip
